{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>{{ 'gift_cards.issued.title' | t }} — {{ shop.name }}</title>
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}
  <style>{% render 'css-variables' %}</style>
  <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
  {{ content_for_header }}
</head>

<body class="template-gift-card">
  <main class="giftcard" role="main">
    <div class="giftcard__card">
      {%- if settings.logo_type == 'image' and settings.logo != blank -%}
        <img
          class="giftcard__logo"
          src="{{ settings.logo | image_url: width: settings.logo_width }}"
          alt="{{ shop.name | escape }}"
          width="{{ settings.logo_width }}"
          height="{{ settings.logo_width | divided_by: settings.logo.aspect_ratio | round }}"
        >
      {%- else -%}
        <h1 class="giftcard__shop">{{ settings.logo_text | default: shop.name }}</h1>
      {%- endif -%}

      <p class="giftcard__subtext">{{ 'gift_cards.issued.subtext' | t }}</p>

      <div class="giftcard__amount">
        {%- if gift_card.balance != gift_card.initial_value -%}
          <s>{{ gift_card.initial_value | money }}</s>
        {%- endif -%}
        {{ gift_card.balance | money }}
      </div>

      <img
        class="giftcard__qr"
        src="{{ gift_card.qr_identifier }}"
        alt=""
        width="180"
        height="180"
        loading="lazy"
      >

      <div class="giftcard__code" data-giftcard-code>{{ gift_card.code | format_code }}</div>

      <button type="button" class="btn btn--outline btn--block" data-giftcard-copy>
        {{ 'gift_cards.issued.copy_code' | t }}
      </button>

      {%- if gift_card.expires_on and gift_card.enabled -%}
        <p class="giftcard__expiry">{{ 'gift_cards.issued.expires_on' | t: expiry: gift_card.expires_on | date: format: 'date' }}</p>
      {%- endif -%}

      <a class="btn btn--primary btn--block btn--lg" href="{{ shop.url }}">{{ 'gift_cards.issued.shop_link' | t }}</a>
    </div>
  </main>

  <script>
    document.querySelector('[data-giftcard-copy]').addEventListener('click', function (e) {
      var code = document.querySelector('[data-giftcard-code]').textContent.trim();
      navigator.clipboard.writeText(code).then(function () {
        e.target.textContent = {{ 'general.social.link_copied' | t | json }};
      });
    });
  </script>
</body>
</html>
