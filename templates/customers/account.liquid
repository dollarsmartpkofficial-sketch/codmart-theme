<div class="wrap section account-page">
  <div class="account-head">
    <h1 class="page-title">{{ 'customer.account.title' | t }}</h1>
    <a class="btn btn--outline btn--sm" href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a>
  </div>

  <div class="account-grid">
    <section>
      <h2>{{ 'customer.account.orders' | t }}</h2>

      {%- paginate customer.orders by 12 -%}
        {%- if customer.orders.size > 0 -%}
          <div class="table-wrap">
            <table class="account-table">
              <thead>
                <tr>
                  <th>{{ 'customer.orders.order_number' | t }}</th>
                  <th>{{ 'customer.orders.date' | t }}</th>
                  <th>{{ 'customer.orders.payment_status' | t }}</th>
                  <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
                  <th>{{ 'customer.orders.total' | t }}</th>
                </tr>
              </thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                    <td>{{ order.created_at | date: format: 'date' }}</td>
                    <td>{{ order.financial_status_label }}</td>
                    <td>{{ order.fulfillment_status_label }}</td>
                    <td>{{ order.total_net_amount | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>

          {%- if paginate.pages > 1 -%}
            {% render 'pagination', paginate: paginate %}
          {%- endif -%}
        {%- else -%}
          <div class="empty-state">
            <p>{{ 'customer.orders.none' | t }}</p>
            <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </section>

    <aside>
      <h2>{{ 'customer.account.details' | t }}</h2>
      <div class="account-card">
        {{ customer.default_address | format_address }}
        <a class="btn btn--outline btn--sm btn--block" href="{{ routes.account_addresses_url }}">
          {{ 'customer.addresses.title' | t }}
        </a>
      </div>
    </aside>
  </div>
</div>
