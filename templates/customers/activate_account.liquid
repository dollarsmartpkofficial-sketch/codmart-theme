<div class="wrap section page-narrow account-page">
  <h1 class="page-title">{{ 'customer.register.title' | t }}</h1>

  {% form 'activate_customer_password' %}
    {%- if form.errors -%}
      <p class="form-error">{{ form.errors | default_errors }}</p>
    {%- endif -%}

    <div class="field">
      <label for="ActivatePassword">{{ 'customer.login.password' | t }}</label>
      <input id="ActivatePassword" type="password" name="customer[password]" autocomplete="new-password" required>
    </div>
    <div class="field">
      <label for="ActivatePasswordConfirm">{{ 'customer.login.password' | t }}</label>
      <input id="ActivatePasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
    </div>

    <button type="submit" class="btn btn--primary btn--block btn--lg">{{ 'customer.register.submit' | t }}</button>
    <button type="submit" name="decline" class="btn btn--outline btn--block">{{ 'general.accessibility.close' | t }}</button>
  {% endform %}
</div>
