<div class="wrap section page-narrow account-page">
  <h1 class="page-title">{{ 'customer.recover_password.title' | t }}</h1>

  {% form 'reset_customer_password' %}
    {%- if form.errors -%}
      <p class="form-error">{{ form.errors | default_errors }}</p>
    {%- endif -%}

    <div class="field">
      <label for="ResetPassword">{{ 'customer.login.password' | t }}</label>
      <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
    </div>
    <div class="field">
      <label for="ResetPasswordConfirm">{{ 'customer.login.password' | t }}</label>
      <input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
    </div>

    <button type="submit" class="btn btn--primary btn--block btn--lg">{{ 'customer.recover_password.submit' | t }}</button>
  {% endform %}
</div>
