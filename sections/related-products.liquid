{%- comment -%}
  Related products.

  Uses Shopify's recommendations endpoint, fetched after the page has
  loaded — so it never delays the product page itself.
{%- endcomment -%}

<div
  class="section wrap"
  data-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <div class="eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if collection -%}
        <a class="link-all" href="{{ collection.url }}">{{ 'general.search.view_all' | t }}</a>
      {%- endif -%}
    </div>

    <div class="product-grid" style="--cols-desktop:{{ section.settings.columns_desktop }}">
      {%- for product in recommendations.products -%}
        {% render 'product-card', product: product, columns: section.settings.columns_desktop %}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Related products",
  "class": "related-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "You may also like" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Related products" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 6, "step": 1, "label": "Products per row", "default": 5 },
    { "type": "range", "id": "limit", "min": 2, "max": 10, "step": 1, "label": "Products to show", "default": 5 }
  ]
}
{% endschema %}
