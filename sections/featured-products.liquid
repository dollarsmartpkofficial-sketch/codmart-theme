{%- liquid
  assign coll = collections[section.settings.collection]
  assign limit = section.settings.limit
  assign cols = section.settings.columns
-%}

<section class="section{% if section.settings.background == 'soft' %} section--soft{% endif %}">
  <div class="wrap">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.show_link and coll != blank -%}
        <a class="link-all" href="{{ coll.url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    {%- if coll.products.size > 0 -%}
      <div class="product-grid" style="--cols-desktop:{{ cols }}">
        {%- for product in coll.products limit: limit -%}
          {% render 'product-card', product: product, columns: cols %}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- comment -%}
        No collection picked yet. Show placeholders so the layout is visible,
        plus a note that only the merchant sees inside the theme editor.
      {%- endcomment -%}
      {%- if request.design_mode -%}
        <p class="editor-note">{{ 'onboarding.pick_collection' | t }}</p>
      {%- endif -%}

      <div class="product-grid" style="--cols-desktop:{{ cols }}">
        {%- for i in (1..limit) -%}
          <article class="card">
            <div class="card__media card__media--square">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="card__body">
              <span class="card__cat">{{ 'onboarding.category' | t }}</span>
              <h3 class="card__title">{{ 'onboarding.product_title' | t }}</h3>
              <div class="card__price">
                <span class="price">{{ 1999 | money }}</span>
                <s class="price--old">{{ 2499 | money }}</s>
              </div>
              <span class="tag-cod">{% render 'icon', name: 'cash', size: 14 %} {{ 'cod.badges.cod' | t }}</span>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "class": "featured-products-section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Hand-picked" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured products" },
    { "type": "text", "id": "text", "label": "Text", "default": "Handpicked top sellers just for you" },
    { "type": "checkbox", "id": "show_link", "label": "Show “view all” link", "default": true },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "View all" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [{ "value": "page", "label": "Page" }, { "value": "soft", "label": "Soft" }],
      "default": "page"
    },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns", "min": 2, "max": 6, "step": 1, "label": "Products per row", "default": 5 },
    { "type": "range", "id": "limit", "min": 2, "max": 20, "step": 1, "label": "Products to show", "default": 5 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
