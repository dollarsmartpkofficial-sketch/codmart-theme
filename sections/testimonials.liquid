<section class="section{% if section.settings.background == 'soft' %} section--soft{% endif %}">
  <div class="wrap">
    <div class="section-head section-head--center">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
    </div>

    <div class="testimonials" style="--cols:{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <figure class="testimonial" {{ block.shopify_attributes }}>
          {%- if block.settings.rating > 0 -%}
            <div class="rating__stars" role="img" aria-label="{{ 'reviews.rating' | t: rating: block.settings.rating }}">
              {%- for i in (1..5) -%}
                {%- if i <= block.settings.rating -%}
                  {% render 'icon', name: 'star', size: 15 %}
                {%- else -%}
                  {% render 'icon', name: 'star-empty', size: 15 %}
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          <blockquote>{{ block.settings.quote }}</blockquote>

          <figcaption class="testimonial__who">
            {%- if block.settings.image != blank -%}
              <img class="avatar" src="{{ block.settings.image | image_url: width: 72 }}" alt="" width="36" height="36" loading="lazy">
            {%- else -%}
              <span class="avatar" aria-hidden="true">{{ block.settings.name | slice: 0 | upcase }}</span>
            {%- endif -%}
            <span>
              <b>{{ block.settings.name }}</b>
              {%- if block.settings.meta != blank -%}<span>{{ block.settings.meta }}</span>{%- endif -%}
            </span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "class": "testimonials-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers say" },
    { "type": "text", "id": "text", "label": "Text", "default": "Thousands of happy customers" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 3 },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [{ "value": "page", "label": "Page" }, { "value": "soft", "label": "Soft" }],
      "default": "page"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "range", "id": "rating", "min": 0, "max": 5, "step": 1, "label": "Rating", "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Great quality and fast delivery. COD made it easy to trust." },
        { "type": "text", "id": "name", "label": "Name", "default": "Ahmed Raza" },
        { "type": "text", "id": "meta", "label": "City / product", "default": "Karachi" },
        { "type": "image_picker", "id": "image", "label": "Photo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "name": "Ahmed Raza", "meta": "Karachi" } },
        { "type": "testimonial", "settings": { "name": "Sana Malik", "meta": "Lahore", "quote": "Product was exactly like the picture. Highly recommended!" } },
        { "type": "testimonial", "settings": { "name": "Usman Khan", "meta": "Islamabad", "quote": "Good price, good quality. Ordered three times already." } }
      ]
    }
  ]
}
{% endschema %}
