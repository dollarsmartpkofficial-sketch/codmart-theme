<section class="section{% if section.settings.background == 'soft' %} section--soft{% endif %}">
  <div class="wrap">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-head{% if section.settings.align == 'center' %} section-head--center{% endif %}">
        <div>
          {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        </div>
        {%- if section.settings.link_label != blank and section.settings.align != 'center' -%}
          <a class="link-all" href="{{ section.settings.link_url | default: routes.collections_url }}">{{ section.settings.link_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if request.design_mode -%}
      {%- liquid
        assign unlinked = 0
        for block in section.blocks
          if block.settings.collection == blank and block.settings.link == blank
            assign unlinked = unlinked | plus: 1
          endif
        endfor
      -%}
      {%- if unlinked > 0 -%}
        <p class="editor-note">{{ 'onboarding.pick_collections' | t }}</p>
      {%- endif -%}
    {%- endif -%}

    <div class="cats" style="--cols-desktop:{{ section.settings.columns }};--cols-mobile:{{ section.settings.columns_mobile }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = collections[block.settings.collection]
          assign label = block.settings.label | default: coll.title
          assign url = coll.url | default: block.settings.link
        -%}
        <a class="cat cat--{{ section.settings.icon_shape }}" href="{{ url }}" {{ block.shopify_attributes }}>
          <span class="cat__icon">
            {%- case block.settings.icon_type -%}
              {%- when 'image' -%}
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 120 }}" alt="" width="56" height="56" loading="lazy">
                {%- endif -%}
              {%- when 'collection' -%}
                {%- if coll.image -%}
                  <img src="{{ coll.image | image_url: width: 120 }}" alt="" width="56" height="56" loading="lazy">
                {%- endif -%}
              {%- when 'none' -%}
              {%- else -%}
                <span aria-hidden="true">{{ block.settings.emoji }}</span>
            {%- endcase -%}
          </span>
          <b>{{ label }}</b>
          {%- if block.settings.show_count and coll != blank -%}
            <span>{{ 'products.facets.product_count' | t: count: coll.all_products_count }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category grid",
  "class": "category-grid-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Browse by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "All categories" },
    { "type": "url", "id": "link_url", "label": "Link" },
    {
      "type": "select",
      "id": "align",
      "label": "Heading alignment",
      "options": [{ "value": "start", "label": "Left" }, { "value": "center", "label": "Center" }],
      "default": "start"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [{ "value": "page", "label": "Page" }, { "value": "soft", "label": "Soft" }],
      "default": "page"
    },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns", "min": 3, "max": 8, "step": 1, "label": "Columns (desktop)", "default": 6 },
    { "type": "range", "id": "columns_mobile", "min": 2, "max": 4, "step": 1, "label": "Columns (mobile)", "default": 3 },
    {
      "type": "select",
      "id": "icon_shape",
      "label": "Icon shape",
      "options": [
        { "value": "circle", "label": "Circle" },
        { "value": "rounded", "label": "Rounded" },
        { "value": "square", "label": "Square" }
      ],
      "default": "circle"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label", "info": "Leave blank to use the collection name." },
        { "type": "url", "id": "link", "label": "Link", "info": "Only used when no collection is selected." },
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon type",
          "options": [
            { "value": "emoji", "label": "Emoji" },
            { "value": "image", "label": "Upload image" },
            { "value": "collection", "label": "Collection image" },
            { "value": "none", "label": "None" }
          ],
          "default": "emoji"
        },
        { "type": "text", "id": "emoji", "label": "Emoji", "default": "🛍️" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category grid",
      "blocks": [
        { "type": "category", "settings": { "emoji": "💪", "label": "Health & Beauty" } },
        { "type": "category", "settings": { "emoji": "🍳", "label": "Kitchen" } },
        { "type": "category", "settings": { "emoji": "📱", "label": "Electronics" } },
        { "type": "category", "settings": { "emoji": "🏠", "label": "Home" } },
        { "type": "category", "settings": { "emoji": "🧸", "label": "Kids" } },
        { "type": "category", "settings": { "emoji": "🌀", "label": "Fans & Cooling" } }
      ]
    }
  ]
}
{% endschema %}
