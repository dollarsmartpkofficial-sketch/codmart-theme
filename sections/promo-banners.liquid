<section class="section">
  <div class="wrap promos" style="--cols:{{ section.blocks.size | at_most: 3 }}">
    {%- for block in section.blocks -%}
      <div
        class="promo"
        style="background:{% if block.settings.image == blank %}linear-gradient(135deg,{{ block.settings.color_from }},{{ block.settings.color_to }}){% endif %};color:{{ block.settings.text_color }}"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          <img
            class="promo__bg"
            src="{{ block.settings.image | image_url: width: 900 }}"
            alt=""
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            loading="lazy"
          >
          <span class="promo__scrim"></span>
        {%- endif -%}

        <div class="promo__text">
          {%- if block.settings.eyebrow != blank -%}<small>{{ block.settings.eyebrow }}</small>{%- endif -%}
          {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a class="btn btn--{{ block.settings.button_style }}" href="{{ block.settings.link }}">{{ block.settings.button_label }}</a>
          {%- endif -%}
        </div>

        {%- if block.settings.emoji != blank and block.settings.image == blank -%}
          <span class="promo__emoji" aria-hidden="true">{{ block.settings.emoji }}</span>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Promo banners",
  "class": "promo-section",
  "max_blocks": 3,
  "settings": [],
  "blocks": [
    {
      "type": "promo",
      "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image", "info": "Optional. Replaces the gradient." },
        { "type": "color", "id": "color_from", "label": "Gradient start", "default": "#741C1C" },
        { "type": "color", "id": "color_to", "label": "Gradient end", "default": "#B33A3A" },
        { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited time" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Up to 50% off" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "emoji", "label": "Emoji", "default": "💄" },
        { "type": "text", "id": "button_label", "label": "Button text", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            { "value": "white", "label": "White" },
            { "value": "sale", "label": "Sale color" },
            { "value": "ghost", "label": "Outline" }
          ],
          "default": "white"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo banners",
      "blocks": [
        { "type": "promo", "settings": { "heading": "Health & Beauty", "text": "Trimmers, rollers, hair removers", "emoji": "💄" } },
        { "type": "promo", "settings": { "heading": "Kids Collection", "text": "Toys, LED cups and more", "emoji": "🌵", "color_from": "#1A1A2E", "color_to": "#3D0E0E", "button_style": "sale" } }
      ]
    }
  ]
}
{% endschema %}
