{%- comment -%}
  Product gallery. Accepts: product

  Media is read through `preview_image` rather than passed to `image_url`
  directly — a product can hold video and 3D models, and only the preview
  image is guaranteed to be an image.

  The first image is eager + high priority: it is the LCP element on a product
  page, and deferring it is the easiest way to lose points.
{%- endcomment -%}

{%- liquid
  assign featured = product.featured_media.preview_image
  assign featured_alt = product.featured_media.alt | default: product.title
-%}

<div class="pdp__gallery" data-gallery>
  {%- if product.media.size > 1 -%}
    <div class="pdp__thumbs">
      {%- for media in product.media limit: 8 -%}
        {%- assign preview = media.preview_image -%}
        <button
          type="button"
          class="pdp__thumb"
          data-gallery-thumb
          data-media-id="{{ media.id }}"
          aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-label="{{ media.alt | default: product.title | escape }}"
        >
          <img
            src="{{ preview | image_url: width: 160 }}"
            data-full="{{ preview | image_url: width: 1200 }}"
            alt=""
            width="76"
            height="76"
            loading="lazy"
          >
          {%- if media.media_type != 'image' -%}
            <span class="pdp__thumb-badge" aria-hidden="true">
              {% render 'icon', name: 'player-play', size: 14 %}
            </span>
          {%- endif -%}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="pdp__main" data-gallery-main>
    {%- if featured -%}
      <img
        src="{{ featured | image_url: width: 1200 }}"
        srcset="
          {{ featured | image_url: width: 600 }} 600w,
          {{ featured | image_url: width: 900 }} 900w,
          {{ featured | image_url: width: 1200 }} 1200w
        "
        sizes="(max-width: 860px) 100vw, 45vw"
        alt="{{ featured_alt | escape }}"
        width="{{ featured.width }}"
        height="{{ featured.height }}"
        fetchpriority="high"
        loading="eager"
      >
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
</div>
