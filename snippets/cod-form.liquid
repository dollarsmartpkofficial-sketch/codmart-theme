{%- comment -%}
  COD quick order form.

  How it works: the form collects name / phone / city / address, then sends
  the shopper to a Shopify cart permalink with those details pre-filled:

    /cart/{variant}:{qty}?checkout[shipping_address][first_name]=…

  Shopify's own checkout opens with everything already entered, so the
  shopper only has to confirm. The order arrives in admin exactly like any
  other order — same customer record, same inventory, same notifications.

  Accepts: product, block
{%- endcomment -%}

{%- liquid
  assign cities = settings.cod_cities | strip | newline_to_br | split: '<br />'
  assign free_threshold = settings.free_shipping_threshold | times: 100
  assign ship_rate = settings.shipping_rate | times: 100
  assign variant = product.selected_or_first_available_variant

  assign cod_note = block.settings.note
  if cod_note == blank
    assign cod_note = 'cod.form.note' | t
  endif
-%}

<div
  class="cod-form"
  id="CodForm-{{ product.id }}"
  data-cod-form
  data-product-id="{{ product.id }}"
  data-free-threshold="{{ free_threshold }}"
  data-ship-rate="{{ ship_rate }}"
  data-variant-id="{{ variant.id }}"
  data-variant-price="{{ variant.price }}"
  data-country="{{ shop.address.country_code | default: localization.country.iso_code }}"
>
  <div class="cod-form__head">
    {% render 'icon', name: 'truck', size: 22 %}
    <div>
      <b>{{ block.settings.heading | default: settings.cod_form_heading }}</b>
      <span>{{ block.settings.subheading | default: settings.cod_form_subheading }}</span>
    </div>
  </div>

  <div class="cod-form__body">

    {%- comment -%} Quantity offers — the biggest lever on average order value. {%- endcomment -%}
    {%- if block.settings.show_offers -%}
      <div class="offers" role="radiogroup" aria-label="{{ block.settings.offers_label }}" data-cod-offers>
        {%- for i in (1..3) -%}
          {%- liquid
            case i
              when 1
                assign qty = block.settings.offer_1_qty
                assign disc = block.settings.offer_1_discount
                assign flag = block.settings.offer_1_flag
              when 2
                assign qty = block.settings.offer_2_qty
                assign disc = block.settings.offer_2_discount
                assign flag = block.settings.offer_2_flag
              when 3
                assign qty = block.settings.offer_3_qty
                assign disc = block.settings.offer_3_discount
                assign flag = block.settings.offer_3_flag
            endcase

            assign full = variant.price | times: qty
            assign remaining = 100 | minus: disc
            assign total = full | times: remaining | divided_by: 100
          -%}
          {%- if qty > 0 -%}
            <button
              type="button"
              class="offer"
              role="radio"
              aria-checked="{% if i == block.settings.offer_default %}true{% else %}false{% endif %}"
              data-cod-offer
              data-qty="{{ qty }}"
              data-discount="{{ disc }}"
            >
              {%- if flag != blank -%}<span class="offer__flag">{{ flag }}</span>{%- endif -%}
              <span class="offer__radio" aria-hidden="true"></span>
              <span class="offer__text">
                <b>{{ qty }} {% if qty == 1 %}{{ block.settings.unit_singular }}{% else %}{{ block.settings.unit_plural }}{% endif %}{% if disc > 0 %} — {{ disc }}% OFF{% endif %}</b>
                {%- if disc > 0 -%}<span>{{ block.settings.offers_save_label }}</span>{%- endif -%}
              </span>
              <span class="offer__amount">
                <b data-offer-total>{{ total | money }}</b>
                {%- if disc > 0 -%}<s>{{ full | money }}</s>{%- endif -%}
              </span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="cod-form__fields">
      <div class="field field--full">
        <label for="CodName-{{ product.id }}">{{ 'cod.form.name' | t }} <span class="req">*</span></label>
        <input id="CodName-{{ product.id }}" type="text" name="name" autocomplete="name"
               placeholder="{{ 'cod.form.name_placeholder' | t }}" required>
        <span class="error" hidden>{{ 'cod.form.errors.name' | t }}</span>
      </div>

      <div class="field">
        <label for="CodPhone-{{ product.id }}">{{ 'cod.form.phone' | t }} <span class="req">*</span></label>
        <input id="CodPhone-{{ product.id }}" type="tel" name="phone" inputmode="tel" autocomplete="tel"
               placeholder="{{ 'cod.form.phone_placeholder' | t }}" required>
        <span class="hint">{{ 'cod.form.phone_hint' | t }}</span>
        <span class="error" hidden>{{ 'cod.form.errors.phone' | t }}</span>
      </div>

      <div class="field">
        <label for="CodCity-{{ product.id }}">{{ 'cod.form.city' | t }} <span class="req">*</span></label>

        {%- if settings.cod_city_field == 'dropdown' -%}
          <select id="CodCity-{{ product.id }}" name="city" required>
            <option value="">{{ 'cod.form.city_placeholder' | t }}</option>
            {%- for city in cities -%}
              {%- assign c = city | strip -%}
              {%- if c != blank -%}<option value="{{ c | escape }}">{{ c }}</option>{%- endif -%}
            {%- endfor -%}
          </select>
        {%- else -%}
          {%- comment -%}
            A text box, but still backed by the city list as suggestions — the
            shopper can type any town without hunting a long dropdown, and the
            common ones are one tap away.
          {%- endcomment -%}
          <input
            id="CodCity-{{ product.id }}"
            type="text"
            name="city"
            list="CodCities-{{ product.id }}"
            autocomplete="address-level2"
            placeholder="{{ 'cod.form.city_typed_placeholder' | t }}"
            required
          >
          {%- if cities.size > 0 -%}
            <datalist id="CodCities-{{ product.id }}">
              {%- for city in cities -%}
                {%- assign c = city | strip -%}
                {%- if c != blank -%}<option value="{{ c | escape }}"></option>{%- endif -%}
              {%- endfor -%}
            </datalist>
          {%- endif -%}
        {%- endif -%}

        <span class="error" hidden>{{ 'cod.form.errors.city' | t }}</span>
      </div>

      <div class="field field--full">
        <label for="CodAddress-{{ product.id }}">{{ 'cod.form.address' | t }} <span class="req">*</span></label>
        <textarea id="CodAddress-{{ product.id }}" name="address" rows="2" autocomplete="street-address"
                  placeholder="{{ 'cod.form.address_placeholder' | t }}" required></textarea>
        <span class="error" hidden>{{ 'cod.form.errors.address' | t }}</span>
      </div>

      {%- if settings.cod_field_email -%}
        <div class="field field--full">
          <label for="CodEmail-{{ product.id }}">{{ 'cod.form.email' | t }} <span class="hint">{{ 'cod.form.optional' | t }}</span></label>
          <input id="CodEmail-{{ product.id }}" type="email" name="email" autocomplete="email" placeholder="you@example.com">
          <span class="error" hidden>{{ 'cod.form.errors.email' | t }}</span>
        </div>
      {%- endif -%}

      {%- if settings.cod_field_notes -%}
        <div class="field field--full">
          <label for="CodNotes-{{ product.id }}">{{ 'cod.form.notes' | t }} <span class="hint">{{ 'cod.form.optional' | t }}</span></label>
          <textarea id="CodNotes-{{ product.id }}" name="notes" rows="2"></textarea>
        </div>
      {%- endif -%}
    </div>

    <div class="order-summary" data-cod-summary>
      <div class="order-summary__row">
        <span data-summary-line>1 × {{ product.title }}</span>
        <span data-summary-price>{{ variant.price | money }}</span>
      </div>
      <div class="order-summary__row" data-summary-discount hidden>
        <span>{{ 'cart.discount' | t }}</span>
        <span data-summary-discount-value></span>
      </div>
      <div class="order-summary__row" data-summary-shipping>
        <span>{{ 'cod.form.delivery' | t }}</span>
        <span data-summary-shipping-value></span>
      </div>
      <div class="order-summary__total">
        <span>{{ 'cod.form.total' | t }}</span>
        <span data-summary-total>{{ variant.price | money }}</span>
      </div>
    </div>

    <button type="button" class="btn btn--cod btn--block btn--lg" data-cod-submit>
      {% render 'icon', name: 'check', size: 18 %}
      {{ block.settings.button_label | default: settings.cod_form_button }}
    </button>

    <p class="cod-note">{{ cod_note }}</p>

    {%- if block.settings.show_badges -%}
      <div class="cod-badges">
        <span>{% render 'icon', name: 'shield', size: 14 %} {{ 'cod.badges.authentic' | t }}</span>
        <span>{% render 'icon', name: 'cash', size: 14 %} {{ 'cod.badges.cod' | t }}</span>
        <span>{% render 'icon', name: 'return', size: 14 %} {{ settings.return_days }}-day returns</span>
        <span>{% render 'icon', name: 'truck', size: 14 %} {{ settings.delivery_time }}</span>
      </div>
    {%- endif -%}
  </div>
</div>
