{%- comment -%}
  Floating WhatsApp button.
  On a product page the pre-filled message includes the product name and URL,
  so the merchant knows what the customer is asking about.
{%- endcomment -%}

{%- liquid
  assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign wa_text = settings.whatsapp_message

  if request.page_type == 'product'
    assign wa_text = wa_text | append: ' ' | append: product.title | append: ' — ' | append: shop.url | append: product.url
  endif

  assign wa_href = wa_text | url_encode | prepend: '?text=' | prepend: wa_number | prepend: 'https://wa.me/'
-%}

<a
  class="wa-float"
  href="{{ wa_href }}"
  target="_blank"
  rel="noopener"
  aria-label="{{ 'products.product.order_on_whatsapp' | t }}"
>
