{%- comment -%}
  Floating WhatsApp button.

  On a product page the pre-filled message carries the product name and URL,
  so the merchant can answer without asking "which one?" first. Elsewhere it
  sends the plain greeting.
{%- endcomment -%}

{%- liquid
  assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign wa_text = settings.whatsapp_message

  if request.page_type == 'product'
    assign wa_text = wa_text | append: ' ' | append: product.title | append: ' — ' | append: shop.url | append: product.url
  endif

  assign wa_href = wa_text | url_encode | prepend: '?text=' | prepend: wa_number | prepend: 'https://wa.me/'
  assign wa_label = 'products.product.order_on_whatsapp' | t
-%}

<a
  class="wa-float"
  href="{{ wa_href }}"
  target="_blank"
  rel="noopener"
  aria-label="{{ wa_label | escape }}"
>
  {% render 'icon', name: 'whatsapp', size: 28 %}
  <span class="wa-float__label">{{ wa_label }}</span>
</a>
